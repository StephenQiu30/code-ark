             self.context_page = await self.browser_context.new_page()
             await self.context_page.goto(self.index_url)
diff --git a/media_platform/zhihu/core.py b/media_platform/zhihu/core.py
index 7b21e3b..c123721 100644
--- a/media_platform/zhihu/core.py
+++ b/media_platform/zhihu/core.py
@@ -98,7 +98,7 @@ class ZhihuCrawler(AbstractCrawler):
