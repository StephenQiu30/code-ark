From 53bfdf9116b737575488eb05df2bbcaf4dbf05b9 Mon Sep 17 00:00:00 2001
From: HotKey <noreply@hotkey.local>
Date: Sat, 26 Sep 2026 12:46:16 +0800
Subject: [PATCH 2/3] HotKey safe mode: enforce requested bilibili note cap

---
 config/base_config.py           | 9 +++++++--
 media_platform/bilibili/core.py | 4 ++++
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/config/base_config.py b/config/base_config.py
index 1b56351..6661646 100644
--- a/config/base_config.py
+++ b/config/base_config.py
@@ -18,6 +18,11 @@
 # 使用本代码即表示您同意遵守上述原则和LICENSE中的所有条款。
 
 # Basic configuration
+import os
+
+# A container cannot launch or attach to the owner's macOS Chrome profile.
+_IN_CONTAINER = os.getenv("MEDIACRAWLER_CONTAINER") == "1"
+
 PLATFORM = "xhs"  # Platform, xhs | dy | ks | bili | wb | tieba | zhihu
 
 # 是否使用海外版小红书 (rednote.com)
@@ -47,7 +52,7 @@ STATIC_PROXY_URL = ""
 # Setting False will open a browser
 # If Xiaohongshu keeps scanning the code to log in but fails, open the browser and manually pass the sliding verification code.
 # If Douyin keeps prompting failure, open the browser and see if mobile phone number verification appears after scanning the QR code to log in. If it does, manually go through it and try again.
-HEADLESS = False
+HEADLESS = _IN_CONTAINER
 
 # Whether to save login status
 SAVE_LOGIN_STATE = True
@@ -56,7 +61,7 @@ SAVE_LOGIN_STATE = True
 # 是否启用 CDP 模式 - 使用用户本地的 Chrome/Edge 浏览器进行爬取，具有更好的反检测能力
 # 开启后，会自动检测并启动用户的 Chrome/Edge 浏览器，通过 CDP 协议进行控制
 # 该方式使用真实浏览器环境，包括用户的扩展、Cookie 和设置，大幅降低被风控检测的风险
-ENABLE_CDP_MODE = True
+ENABLE_CDP_MODE = not _IN_CONTAINER
 
 # CDP 调试端口，用于与浏览器通信
 # 如果端口被占用，系统会自动尝试下一个可用端口
diff --git a/media_platform/bilibili/core.py b/media_platform/bilibili/core.py
index fa931d3..554718e 100644
--- a/media_platform/bilibili/core.py
+++ b/media_platform/bilibili/core.py
@@ -200,6 +200,9 @@ class BilibiliCrawler(AbstractCrawler):
         """
         utils.logger.info("[BilibiliCrawler.search_by_keywords] Begin search bilibli keywords")
         bili_limit_count = 20  # bilibili limit page fixed value
+        # HotKey: remember the requested cap; one search page still returns 20 results,
+        # but only this many videos get the follow-up detail and comment requests.
+        requested_notes = config.CRAWLER_MAX_NOTES_COUNT
         if config.CRAWLER_MAX_NOTES_COUNT < bili_limit_count:
             config.CRAWLER_MAX_NOTES_COUNT = bili_limit_count
         start_page = config.START_PAGE  # start page number
@@ -228,6 +231,7 @@ class BilibiliCrawler(AbstractCrawler):
                 if not video_list:
                     utils.logger.info(f"[BilibiliCrawler.search_by_keywords] No more videos for '{keyword}', moving to next keyword.")
                     break
+                video_list = video_list[:requested_notes]  # HotKey: enforce the requested cap
 
                 semaphore = asyncio.Semaphore(config.MAX_CONCURRENCY_NUM)
                 task_list = []
-- 
