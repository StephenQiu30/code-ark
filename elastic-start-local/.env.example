# Elastic Stack configuration
# Use the generic version tags by default so Docker can pull the host-matching image.
START_LOCAL_VERSION=0.13.0
ES_LOCAL_VERSION=9.3.0
IK_VERSION=9.3.0

# Container names
ES_LOCAL_CONTAINER_NAME=es-local-dev
KIBANA_LOCAL_CONTAINER_NAME=kibana-local-dev
KIBANA_LOCAL_SETTINGS_CONTAINER_NAME=kibana-local-settings
LOGSTASH_LOCAL_CONTAINER_NAME=logstash-local-dev

# Ports
ES_LOCAL_PORT=9200
KIBANA_LOCAL_PORT=5601
LOGSTASH_LOCAL_PORT=5044
ES_LOCAL_URL=http://localhost:${ES_LOCAL_PORT}

# Credentials and keys
ES_LOCAL_PASSWORD=change_me_elastic_password
KIBANA_LOCAL_PASSWORD=change_me_kibana_system_password
KIBANA_ENCRYPTION_KEY=change-this-to-a-32-plus-char-encryption-key

# Optional settings used by start.sh
ES_LOCAL_DISK_SPACE_REQUIRED=1gb
ES_LOCAL_LICENSE_EXPIRE_DATE=1893456000
# Keep the development heap modest: Elasticsearch also needs native/direct memory.
ES_LOCAL_JAVA_OPTS="-Xms512m -Xmx512m"
ES_LOCAL_MEM_LIMIT=2g
ES_LOCAL_MEM_RESERVATION=1g
ES_LOCAL_API_KEY=replace_if_you_need_license_renewal_via_start_sh

# Refuse to start when the Docker VM is too small for the complete stack.
ELASTIC_STACK_MIN_DOCKER_MEMORY_GB=6

# Kibana
KIBANA_LOCAL_NODE_OPTIONS="--max-old-space-size=768"
KIBANA_LOCAL_MEM_LIMIT=1536m
KIBANA_LOCAL_MEM_RESERVATION=768m
KIBANA_SETTINGS_MEM_LIMIT=256m

# Logstash
LOGSTASH_LOCAL_VERSION=9.3.0
LOGSTASH_LOCAL_JAVA_OPTS="-Xms256m -Xmx256m"
LOGSTASH_LOCAL_MEM_LIMIT=1g
LOGSTASH_LOCAL_MEM_RESERVATION=512m
