# Fixed image versions; server and schema tools use the same TEMPORAL_VERSION.
TEMPORAL_VERSION=1.31.0
TEMPORAL_UI_VERSION=2.49.1

# Host access. Container clients use temporal:7233 on the existing PGSQL network.
TEMPORAL_BIND_ADDRESS=127.0.0.1
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=18080

# Reuse pgsql-start-local. Use a working existing database account.
# Its credentials may differ from .env if the data was initialized earlier.
PGSQL_DOCKER_NETWORK=pgsql-start-local_default
TEMPORAL_POSTGRES_HOST=pgsql-start-dev
PGSQL_USER=user
PGSQL_PASSWORD=your_existing_pgsql_password_here

TEMPORAL_NAMESPACE=default
TZ=Asia/Shanghai
