{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Ark",
  "version": "0.1.0",
  "identifier": "io.codeark.toolbox",
  "build": {
    "beforeDevCommand": "pnpm sync && pnpm verify --mode development && pnpm dev",
    "beforeBuildCommand": "pnpm sync && pnpm verify --mode candidate --target mac-arm64 && pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Code Ark",
        "width": 1180,
        "height": 800,
        "minWidth": 880,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/blueprints/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
